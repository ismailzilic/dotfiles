{
  	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  	"logo": {
    		"type": "auto",
    		"source": "~/dotfiles/.config/fastfetch/logo.txt",
    		"width": 65,
    		"padding": {
      			"top": 1,
      			"left": 1
    		},
    		"color": {
			"1": "white"
    		}
  	},

  	"display": {
    		"separator": " \u2192 ",
    		"color": {
      			"keys": "white",
      			"title": "white"
    		},
    		"key": {
      			"type": "both"
    		}
  	},

  	"modules": [
    		"break",
    		"title",
    		"break",
    		{ "type": "os", "key": "OS" },
    		{ "type": "kernel", "key": "Kernel" },
    		{ "type": "uptime", "key": "Uptime" },
    		"break",
    		{ "type": "cpu", "key": "CPU" },
    		{ "type": "gpu", "key": "GPU" },
    		{ "type": "memory", "key": "RAM" },
    		"break",
    		{ "type": "shell", "key": "Shell" },
    		{ "type": "terminal", "key": "Terminal" },
    		"break",
    		{ "type": "colors", "symbol": "circle" }
  	]
}
